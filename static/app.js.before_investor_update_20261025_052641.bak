      <p>
        Update your venture details as you learn
        more about your customers.
      </p>

      <form id="genomeForm">
        <div class="grid two">
          <label>
            Venture name
            <input
              name="name"
              value="${esc(venture.name)}"
              required
            >
          </label>

          <label>
            Location
            <input
              name="location"
              value="${esc(venture.location)}"
            >
          </label>

          <label>
            Industry
            <input
              name="industry"
              value="${esc(venture.industry)}"
            >
          </label>

          <label>
            Target customers
            <textarea name="customers">${esc(venture.customers)}</textarea>
          </label>
        </div>

        <label>
          Problem
          <textarea name="problem" rows="3">${esc(venture.problem)}</textarea>
        </label>

        <label>
          Value proposition
          <textarea name="proposition" rows="3">${esc(venture.proposition)}</textarea>
        </label>

        <button class="primary">
          Save updated assumptions
        </button>
      </form>
    </div>

    <div class="card">
      <h3>Validate your assumptions</h3>

      <p>
        Ask the AI mentor to challenge your business model
        and recommend customer research activities.
      </p>

      <button
        class="ghost"
