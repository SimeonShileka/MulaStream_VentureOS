// ============================================================
// EVIDENCE LEDGER
// ============================================================

function evidence(data) {
  const records = data.evidence;

  $('content').innerHTML = `
    <div class="grid two">
      <div class="card">
        <h3>Add an evidence claim</h3>

        <p>
          Describe a real observation and its source.
        </p>

        <form id="evidenceForm">
          <label>
            Claim or observation
            <textarea
              name="claim"
              maxlength="1000"
              required
            ></textarea>
          </label>

          <label>
            Source description
            <input
              name="source"
              maxlength="500"
            >
          </label>

          <button class="primary">
            Save evidence record
          </button>
        </form>
      </div>

      <div class="card">
        <h3>Evidence verification</h3>

        <p>
          A submitted claim is not independently verified
          until an authorised reviewer examines it.
        </p>

        <button
          class="ghost"
          onclick="navigate('readiness')"
        >
          Upload supporting file
        </button>
      </div>
    </div>

    <div class="card">
      <h3>Evidence ledger (${records.length})</h3>

      <div class="grid two">
        <label>
          Search entries
          <input
            id="evidenceSearch"
            placeholder="Search claims and sources"
          >
        </label>

        <label>
          Review status
          <select id="evidenceFilter">
            <option value="all">All statuses</option>
            <option value="unreviewed">Unreviewed</option>
            <option value="approved">Approved</option>
            <option value="rejected">Rejected</option>
          </select>
        </label>
      </div>

      <div id="evidenceRecords"></div>
    </div>
  `;

  $('evidenceForm').onsubmit = async event => {
    event.preventDefault();

    try {
      await api(
        `/ventures/${selected}/evidence`,
        'POST',
        Object.fromEntries(new FormData(event.target))
      );

      await render();
    } catch (error) {
      err(error);
    }
  };

  function drawRecords() {
    const search = $('evidenceSearch')
      .value.toLowerCase().trim();

    const status = $('evidenceFilter').value;

    const filtered = records.filter(record => {
      const matchesStatus =
        status === 'all' || record.status === status;

      const matchesSearch =
        `${record.claim} ${record.source}`
          .toLowerCase().includes(search);

      return matchesStatus && matchesSearch;
    });

    $('evidenceRecords').innerHTML =
      filtered.map(record => `
        <div class="record">
          <div class="row-between">
            <strong>${esc(record.claim)}</strong>

            <span class="tag">
              ${esc(record.status)}
            </span>
          </div>

          <small>
            Source:
            ${esc(record.source || 'Not specified')}
          </small>

          ${record.status === 'unreviewed' ? `
            <div class="toolbar">
              <button
                class="ghost"
                onclick="editLedgerEntry(${record.id})"
              >
                Edit
              </button>

              <button
                class="ghost"
                onclick="deleteLedgerEntry(${record.id})"
              >
                Delete
              </button>
            </div>
          ` : ''}
        </div>
      `).join('') ||
      '<p>No matching evidence records.</p>';
  }

  $('evidenceSearch').oninput = drawRecords;
  $('evidenceFilter').onchange = drawRecords;

  drawRecords();
}

async function editLedgerEntry(id) {
  try {
    const data = await api(
      `/ventures/${selected}/dashboard`
    );

    const record = data.evidence.find(
      item => item.id === id
    );

    if (!record) return;

    const claim = prompt(
      'Edit evidence claim',
      record.claim
    );

    if (claim === null) return;

    const source = prompt(
      'Edit source description',
      record.source || ''
    );

    if (source === null) return;

    await api(
      `/ventures/${selected}/evidence/${id}`,
      'PATCH',
      { claim, source }
    );

    await render();
  } catch (error) {
    err(error);
  }
}

async function deleteLedgerEntry(id) {
  if (!confirm(
    'Permanently delete this unreviewed evidence record?'
  )) {
    return;
  }

  try {
    await api(
      `/ventures/${selected}/evidence/${id}`,
      'DELETE'
    );

    await render();
  } catch (error) {
    err(error);
  }
}

// ============================================================
// FINANCIAL LABORATORY
// ============================================================

function finance(data) {
  const venture = data.venture;
  const finances = data.financials;

  $('content').innerHTML = `
    <div class="hero">
      <span class="eyebrow">
        UNIT ECONOMICS / NAD
      </span>

      <h1>Financial Laboratory</h1>

      <p>
        Estimate monthly revenue, costs and operating profit
        using your own business assumptions.
      </p>
    </div>

    <div class="grid">
      <div class="card">
        <span class="eyebrow">
          ESTIMATED REVENUE
        </span>

        <div class="financial-value">
          N$ ${finances.revenue.toLocaleString()}
        </div>
      </div>

      <div class="card">
        <span class="eyebrow">
          TOTAL COSTS
        </span>

        <div class="financial-value">
          N$ ${(finances.variable_cost +
            finances.fixed_cost).toLocaleString()}
        </div>
      </div>

      <div class="card">
        <span class="eyebrow">
          ESTIMATED OPERATING RESULT
        </span>

        <div class="financial-value">
          N$ ${finances.estimated_profit.toLocaleString()}
        </div>
      </div>
    </div>

    <div class="card">
      <h3>Financial assumptions</h3>

      <form id="financeForm" class="finance-form">
        ${[
          ['price', 'Selling price per unit'],
          ['unit_cost', 'Direct cost per unit'],
          ['monthly_units', 'Units sold per month'],
          ['fixed_cost', 'Monthly fixed costs']
        ].map(([key, label]) => `
          <label>
            ${label}

            <input
              name="${key}"
              type="number"
              min="0"
              step="${key === 'monthly_units' ? '1' : '0.01'}"
              value="${venture[key]}"
            >
          </label>
        `).join('')}

        <div>
          <button class="primary">
            Recalculate and save
          </button>
        </div>
      </form>

      <p class="hint">
        Estimates are illustrative and are not verified forecasts.
      </p>
    </div>
  `;

  $('financeForm').onsubmit = async event => {
    event.preventDefault();

    try {
      await api(
        `/ventures/${selected}`,
        'PATCH',
        Object.fromEntries(new FormData(event.target))
      );

      await render();
    } catch (error) {
      err(error);
    }
  };
}

// ============================================================
// AI MENTOR / GEMINI CHAT
// ============================================================

async function renderChat() {
  if (!chatId && chats.length) {
    chatId = chats[0].id;
  }

  $('content').innerHTML = `
    <div class="chat-layout">
      <div class="card" style="overflow:auto">
        <div class="row-between">
          <h3>Conversations</h3>

          <button
            class="plus"
            onclick="newChat()"
          >
            +
          </button>
        </div>

        ${chats.map(chat => `
          <div class="record">
            <button
              class="link"
              onclick="openChat(${chat.id})"
            >
              ${esc(chat.title)}
            </button>
          </div>
        `).join('') || '<p>No chats yet.</p>'}
      </div>

      <div class="chat-panel">
        <header>
          AI Venture Mentor
          <span class="tag" style="float:right">
            Gemini AI
          </span>
        </header>

        <div
          id="messages"
          class="messages"
        ></div>

        <form
          id="compose"
          class="composer"
        >
          <textarea
            id="messageText"
            maxlength="3000"
            placeholder="Ask your business mentor a question..."
            required
          ></textarea>

          <button class="primary">
            Send
          </button>
        </form>
      </div>
    </div>
  `;

  if (!chatId) {
    $('messages').innerHTML = `
      <div class="empty">
        <h3>Begin a conversation</h3>

        <p>
          Your conversations are saved to your account.
        </p>
      </div>
    `;
  } else {
    try {
      const data = await api(`/chats/${chatId}`);

      $('messages').innerHTML =
        data.messages.map(message => `
          <div class="bubble ${
            message.role === 'user' ? 'user' : ''
          }">
            ${esc(message.body)}
          </div>
        `).join('') ||
        '<div class="empty">Ask your first question.</div>';
    } catch (error) {
      $('messages').textContent = error.message;
    }
  }

  const messageArea = $('messages');
  messageArea.scrollTop = messageArea.scrollHeight;

  $('compose').onsubmit = async event => {
    event.preventDefault();

    const field = $('messageText');
    const message = field.value.trim();

    if (!message) return;

    field.value = '';

    const button = event.target.querySelector('button');
    button.disabled = true;

    try {
      if (!chatId) {
        const result = await api('/chats', 'POST', {
          venture_id: selected || null
        });

        chatId = result.id;
      }

      await api(
        `/chats/${chatId}/send`,
        'POST',
        { message }
      );

      chats = await api('/chats');

      renderChats();
      await renderChat();
    } catch (error) {
      field.value = message;
      err(error);
    } finally {
      button.disabled = false;
    }
  };
}

// ============================================================
// 90-DAY INCUBATOR
// ============================================================

async function renderIncubator() {
  if (!selected) {
    renderStartPage();
    return;
  }

  const ventureId = selected;

  try {
    const data = await api(
      `/ventures/${ventureId}/incubator`
    );

    if (
      view !== 'incubator' ||
      selected !== ventureId
    ) {
      return;
    }

    $('content').innerHTML = `
      <div class="hero">
        <span class="eyebrow">
          90-DAY INCUBATION PROGRAMME
        </span>

        <h1>From founder to investor-ready</h1>

        <p>
          Complete every deliverable and submit supporting
          evidence for independent review.
        </p>

        <div class="metric">
          ${data.readiness_score}%
        </div>

        <small>
          Provisional coverage ·
          ${data.reviewed_stages}/8 reviewed stages
        </small>
      </div>

      <div class="card">
        <h3>Plan your startup capital</h3>

        <p>
          Example allocations only.
          Confirm actual costs with suppliers.
        </p>

        <form onsubmit="showBudget(event)">
          <label>
            Starting capital (N$)
            <input
              name="amount"
              type="number"
              min="100"
              max="1000000"
              value="10000"
              required
            >
          </label>

          <label>
            Business type

            <select name="kind">
              <option value="retail">
                Retail business
              </option>

              <option value="service">
                Service business
              </option>

              <option value="food">
                Food business
              </option>
            </select>
          </label>

          <button class="ghost">
            Calculate allocation
          </button>
        </form>

        <div id="budgetOutput"></div>
      </div>

      <div class="grid">
        ${data.roadmap.map(month => `
          <div class="card">
            <span class="eyebrow">
              MONTH ${month.month}
            </span>

            <h3>${esc(month.name)}</h3>
            <p>${esc(month.goal)}</p>
          </div>
        `).join('')}
      </div>

      ${data.stages.map(stage => `
        <div
          class="card"
          style="
            margin-top:18px;
            opacity:${stage.unlocked ? 1 : 0.78};
          "
        >
          <div class="row-between">
            <div>
              <span class="eyebrow">
                MONTH ${stage.month} ·
                STAGE ${stage.number}
              </span>

              <h3>${esc(stage.title)}</h3>
            </div>

            <span class="tag">
              ${esc(
                String(stage.status).replaceAll('_', ' ')
              )}
            </span>
          </div>

          <p>${esc(stage.goal)}</p>

          <h4>Activities</h4>

          <p>
            ${stage.activities.map(esc).join(' · ')}
          </p>

          <h4>Required deliverables</h4>

          ${stage.deliverables.map((deliverable, index) => {
            const submission = stage.submissions.find(
              item => item.deliverable === deliverable
            );

            const approved =
              submission?.reviewer_status === 'approved';

            const canWrite =
              stage.unlocked && !approved;

            const status = submission
              ? String(
                  submission.reviewer_status || 'pending'
                ).replaceAll('_', ' ')
              : 'Not submitted';

            return `
              <details
                class="record"
                ${index === 0 && stage.unlocked
                  ? 'open'
                  : ''}
              >
                <summary
                  style="
                    cursor:pointer;
                    padding:8px 0;
                    font-weight:600;
                  "
                >
                  ${esc(deliverable)}

                  <div>
                    <small style="font-weight:400">
                      ${esc(status)}

                      ${submission
                        ? ' · Provisional score ' +
                          Number(submission.ai_score) +
                          '/100'
                        : ''}
                    </small>
                  </div>
                </summary>

                <div style="padding:10px 0">
                  ${!stage.unlocked ? `
                    <p class="hint">
                      This stage is locked until earlier
                      stages receive the required approvals.
                    </p>
                  ` : ''}

                  <form
                    onsubmit="submitIncubator(
                      event,
                      ${stage.number}
                    )"
                  >
                    <input
                      type="hidden"
                      name="deliverable"
                      value="${esc(deliverable)}"
                    >

                    <label>
                      Your work for this deliverable

                      <textarea
                        name="narrative"
                        rows="6"
                        minlength="40"
                        maxlength="12000"
                        required
                        ${canWrite ? '' : 'readonly'}
                      >${esc(
                        submission?.narrative || ''
                      )}</textarea>
                    </label>

                    <label>
                      Evidence reference

                      <input
                        name="evidence_ref"
                        maxlength="500"
                        value="${esc(
                          submission?.evidence_ref || ''
                        )}"
                        placeholder="Survey, interview, document or source"
                        ${canWrite ? '' : 'readonly'}
                      >
                    </label>

                    ${submission?.ai_feedback ? `
                      <p class="hint">
                        <strong>Draft feedback:</strong>
                        ${esc(submission.ai_feedback)}
                      </p>
                    ` : ''}

                    ${approved ? `
                      <p class="hint">
                        Approved by an authorised reviewer.
                        This deliverable is read-only.
                      </p>
                    ` : ''}

                    ${canWrite ? `
                      <button class="primary">
                        ${submission
                          ? 'Update and submit for review'
                          : 'Assess and save deliverable'}
                      </button>
                    ` : ''}
                  </form>
                </div>
              </details>
            `;
          }).join('')}
        </div>
      `).join('')}

      <div class="card">
        <h3>Investor dossier</h3>

        <p>
          Export your current draft deliverables
          and outstanding requirements.
        </p>

        <button
          class="ghost"
          onclick="downloadDossier()"
        >
          Export due diligence draft
        </button>
      </div>
    `;
  } catch (error) {
    if (
      view === 'incubator' &&
      selected === ventureId
    ) {
      $('content').textContent = error.message;
    }
  }
}

async function submitIncubator(event, stage) {
  event.preventDefault();

  const data = Object.fromEntries(
    new FormData(event.target)
  );

  try {
    const result = await api(
      `/ventures/${selected}/incubator/${stage}/submit`,
      'POST',
      data
    );

    alert(
      `Provisional score: ${result.score}/100.\n\n` +
      `${result.feedback}\n\n` +
      'Independent reviewer approval is still required.'
    );

    await renderIncubator();
  } catch (error) {
    err(error);
  }
}

async function downloadDossier() {
  try {
    const data = await api(
      `/ventures/${selected}/investor-package`
    );

    const blob = new Blob(
      [JSON.stringify(data, null, 2)],
      { type: 'application/json' }
    );

    const url = URL.createObjectURL(blob);

    const link = document.createElement('a');
    link.href = url;
    link.download = 'venture_due_diligence_draft.json';
    link.click();

    URL.revokeObjectURL(url);
  } catch (error) {
    err(error);
  }
}

// ============================================================
// BUSINESS BUDGET
// ============================================================

async function showBudget(event) {
  event.preventDefault();

  const form = event.target;

  const amount = form.elements.amount.value;
  const kind = form.elements.kind.value;

  try {
    const data = await api(
      `/business-budget?amount=${
        encodeURIComponent(amount)
      }&kind=${encodeURIComponent(kind)}`
    );

    $('budgetOutput').innerHTML = `
      <h3>
        N$ ${data.starting_capital_nad.toLocaleString()}
        suggested allocation
      </h3>

      ${data.allocations.map(item => `
        <div class="record">
          <strong>${esc(item.category)}</strong>

          ${item.percentage}%:

          N$ ${item.amount_nad.toLocaleString()}
        </div>
      `).join('')}

      <p>
        <strong>
          Total: N$ ${data.total_nad.toLocaleString()}
        </strong>
      </p>

      <p class="hint">
        ${esc(data.caution)}
      </p>
    `;
  } catch (error) {
    err(error);
  }
}

// ============================================================
// READINESS, REWARDS AND FILE UPLOADS
// ============================================================

async function renderReadiness() {
  if (!selected) {
    $('content').innerHTML =
      '<div class="card">Create or select a venture first.</div>';
    return;
  }

  try {
    const [assessment, rewards, uploads, interest] =
      await Promise.all([
        api(`/ventures/${selected}/assessment`),
        api(`/ventures/${selected}/rewards`),
        api(`/ventures/${selected}/uploads`),
        api(`/ventures/${selected}/investor-interest`)
      ]);

    $('content').innerHTML = `
      <div class="hero">
        <h1>Evidence-based readiness</h1>

        <div class="metric">
          ${assessment.overall}/100
        </div>

        <p>${esc(assessment.interpretation)}</p>

        <button
          class="primary"
          onclick="saveReadiness()"
        >
          Save assessment snapshot
        </button>
      </div>

      <div class="grid two">
        <div class="card">
          <h3>Ten assessment criteria</h3>

          ${assessment.criteria.map(item => `
            <div class="record">
              <strong>
                ${esc(item.criterion)}
              </strong>

              ${item.score}/100

              <small>
                ${esc(item.confidence)} confidence ·
                ${item.verified_items} approved items
              </small>
            </div>
          `).join('')}
        </div>

        <div class="card">
          <h3>Progress rewards</h3>

          <div class="metric">
            ${rewards.points} points
          </div>

          <p>
            ${rewards.badge_count} earned badges
          </p>

          ${rewards.badges.map(badge => `
            <div class="record">
              Stage ${badge.stage}:
              ${esc(badge.name)}
            </div>
          `).join('')}

          <h3>Investor enquiries</h3>

          ${interest.map(item => `
            <div class="record">
              ${esc(
                item.note || 'Interested investor'
              )}

              <small>
                ${new Date(
                  item.created_at * 1000
                ).toLocaleDateString()}
              </small>
            </div>
          `).join('') ||
          '<p>No expressions of interest yet.</p>'}
        </div>
      </div>

      <div class="card">
        <h3>Supporting evidence upload</h3>

        <p>
          Maximum file size: 5 MB.
          Do not upload sensitive banking or identity records
          into this demo.
        </p>

        <form id="evidenceUpload">
          <label>
            Incubator stage

            <select name="stage">
              ${Array.from(
                { length: 8 },
                (_, index) => `
                  <option value="${index + 1}">
                    Stage ${index + 1}
                  </option>
                `
              ).join('')}
            </select>
          </label>

          <label>
            Deliverable description
            <input
              name="deliverable"
              required
            >
          </label>

          <input
            type="file"
            name="file"
            required
          >

          <button class="primary">
            Upload supporting evidence
          </button>
        </form>

        <h3>Saved files</h3>

        ${uploads.map(file => `
          <div class="record">
            ${esc(file.filename)}

            <small>
              Stage ${file.stage} ·
              Awaiting manual verification
            </small>
          </div>
        `).join('') || '<p>No files uploaded.</p>'}
      </div>
    `;

    $('evidenceUpload').onsubmit = async event => {
      event.preventDefault();

      const form = new FormData(event.target);

      try {
        const response = await fetch(
          `/api/ventures/${selected}/upload`,
          {
            method: 'POST',
            credentials: 'same-origin',
            headers: {
              'x-csrf-token': csrf
            },
            body: form
          }
        );

        const result = await response.json();

        if (!response.ok) {
          throw new Error(
            result.detail || 'Upload failed'
          );
        }

        alert(result.notice);
        await renderReadiness();
      } catch (error) {
        err(error);
      }
    };
  } catch (error) {
    $('content').textContent = error.message;
  }
}

async function saveReadiness() {
  try {
    await api(
      `/ventures/${selected}/assessment`,
      'POST',
      {}
    );

    alert('Assessment snapshot saved.');
    await renderReadiness();
  } catch (error) {
    err(error);
  }
}

// ============================================================
// INVESTOR PORTAL
// ============================================================

async function renderInvestors() {
  if (account?.role !== 'investor') {
    $('content').textContent =
      'Investor account required.';
    return;
  }

  try {
    const data = await api('/investor/opportunities');

    $('content').innerHTML = `
      <div class="hero">
        <span class="eyebrow">
          INVESTOR PORTAL
        </span>

        <h1>Investment Opportunities</h1>

        <p>${esc(data.notice)}</p>

        ${canReview ? `
          <button
            class="ghost"
            onclick="navigate('review')"
          >
            Open Reviewer Workspace
          </button>
        ` : ''}
      </div>

      ${data.opportunities.map(venture => `
        <div class="card" style="margin-top:12px">
          <h3>${esc(venture.name)}</h3>

          <p>
            ${esc(venture.industry)} ·
            ${esc(venture.location)}
          </p>

          <p>
            Evidence coverage:
            ${venture.readiness_score}/100
          </p>

          <p>${esc(venture.problem)}</p>

          <p>${esc(venture.proposition)}</p>

          <button
            class="primary"
            onclick="expressInterest(${venture.id})"
          >
            Express interest
          </button>
        </div>
      `).join('') || `
        <div class="card">
          No approved investment opportunities
          have been published yet.
        </div>
      `}
    `;
  } catch (error) {
    $('content').innerHTML = `
      <div class="card">
        ${esc(error.message)}
      </div>
    `;
  }
}

async function expressInterest(id) {
  const note = prompt(
    'Optional interest message:'
  );

  if (note === null) return;

  try {
    await api(
      `/investor/opportunities/${id}/interest`,
      'POST',
      { note }
    );

    alert('Expression of interest saved.');
  } catch (error) {
    err(error);
  }
}

// ============================================================
// AUTHORISED REVIEWER WORKSPACE
// ============================================================

async function renderReviews() {
  if (!canReview) {
    $('content').innerHTML = `
      <div class="card">
        <h3>Access Restricted</h3>

        <p>
          Only administrators and authorised investor
          reviewers can access this workspace.
        </p>
      </div>
    `;
    return;
  }

  try {
    const submissions = await api('/review/queue');

    $('content').innerHTML = `
      <div class="hero">
        <span class="eyebrow">
          AUTHORISED REVIEWER WORKSPACE
        </span>

        <h1>Mentor Review</h1>

        <p>
          Check each submission and its supporting evidence
          before making a decision.
        </p>

        <button
          class="ghost"
          onclick="exitReviewerWorkspace()"
        >
          Exit Reviewer Workspace
        </button>
      </div>

      ${submissions.map(item => `
        <div class="card" style="margin-top:12px">
          <span class="eyebrow">
            STAGE ${item.stage}
          </span>

          <h3>${esc(item.venture)}</h3>

          <h4>${esc(item.deliverable)}</h4>

          <p>${esc(item.narrative)}</p>

          <div class="record">
            <strong>Evidence reference:</strong>
            ${esc(item.evidence_ref || 'Missing')}
          </div>

          <p>
            Provisional assessment:
            ${Number(item.ai_score)}/100
          </p>

          <p class="hint">
            Automated scores do not verify the
            authenticity of submitted evidence.
          </p>

          <div class="toolbar">
            <button
              class="primary"
              onclick="makeReview(
                ${item.id},
                'approved'
              )"
            >
              Approve
            </button>

            <button
              class="ghost"
              onclick="makeReview(
                ${item.id},
                'needs_changes'
              )"
            >
              Request Corrections
            </button>

            <button
              class="ghost"
              onclick="makeReview(
                ${item.id},
                'rejected'
              )"
            >
              Reject
            </button>
          </div>
        </div>
      `).join('') ||
      '<div class="card">No submissions awaiting review.</div>'}
    `;
  } catch (error) {
    $('content').innerHTML = `
      <div class="card">
        <h3>Reviewer Access Error</h3>

        <p>${esc(error.message)}</p>

        <button
          class="ghost"
          onclick="exitReviewerWorkspace()"
        >
          Exit
        </button>
      </div>
    `;
  }
}

function exitReviewerWorkspace() {
  if (account?.role === 'admin') {
    navigate('admin');
  } else {
    navigate('investors');
  }
}

async function makeReview(id, decision) {
  const reason = prompt(
    'Explain your decision and the evidence checked (at least 12 characters):'
  );

  if (
    !reason ||
    reason.trim().length < 12
  ) {
    alert(
      'Provide a detailed reason of at least 12 characters.'
    );
    return;
  }

  try {
    await api(
      `/review/${id}`,
      'POST',
      {
        decision,
        reason: reason.trim()
      }
    );

    alert('Review decision saved.');

    await renderReviews();
  } catch (error) {
    err(error);
  }
}

// ============================================================
// ADMINISTRATOR DASHBOARD
// ============================================================

async function renderAdmin() {
  if (account?.role !== 'admin') {
    $('content').textContent =
      'Administrator access required.';
    return;
  }

  try {
    const [summary, users, audit] =
      await Promise.all([
        api('/admin/summary'),
        api('/admin/users'),
        api('/admin/audit')
      ]);

    if (view !== 'admin') return;

    const statistics = Object.entries(summary)
      .map(([key, value]) => `
        <div class="card">
          <span class="eyebrow">
            ${esc(key.replaceAll('_', ' '))}
          </span>

          <div class="metric">
            ${Number(value) || 0}
          </div>
        </div>
      `).join('');

    const userRecords = users.map(user => `
      <div class="record">
        <div class="row-between">
          <div>
            <strong>${esc(user.name)}</strong>

            <small>
              ${esc(user.email)}
            </small>
          </div>

          <span class="tag">
            ${esc(
              user.is_admin
                ? 'Administrator'
                : user.role
            )}
          </span>
        </div>

        <p>
          ${user.is_reviewer
            ? 'Authorised reviewer'
            : 'No reviewer permissions'}
        </p>

        ${user.role === 'investor' &&
          !user.is_admin ? `
          <button
            class="ghost"
            onclick="setReviewerPermission(
              ${user.id},
              ${!user.is_reviewer}
            )"
          >
            ${user.is_reviewer
              ? 'Revoke Reviewer Access'
              : 'Authorise as Reviewer'}
          </button>
        ` : ''}
      </div>
    `).join('');

    const auditRecords = audit.map(item => `
      <div class="record">
        <strong>
          ${esc(item.action)}
        </strong>

        <p>
          ${esc(item.target)}
        </p>

        <small>
          ${new Date(
            item.created_at * 1000
          ).toLocaleString()}
        </small>
      </div>
    `).join('');

    $('content').innerHTML = `
      <div class="hero">
        <span class="eyebrow">
          ADMINISTRATOR PORTAL
        </span>

        <h1>Platform Administration</h1>

        <p>
          Manage registered accounts,
          authorised investor reviewers,
          submissions and platform activity.
        </p>

        <div class="toolbar">
          <button
            class="primary"
            onclick="navigate('review')"
          >
            Open Review Queue
          </button>

          <button
            class="ghost"
            onclick="logout()"
          >
            Sign Out
          </button>
        </div>
      </div>

      <div class="grid">
        ${statistics}
      </div>

      <div class="card">
        <h3>User Management</h3>

        ${userRecords ||
          '<p>No registered users.</p>'}
      </div>

      <div class="card">
        <h3>Submission Verification</h3>

        <p>
          Review submitted deliverables and
          supporting evidence without a reviewer token.
        </p>

        <button
          class="primary"
          onclick="navigate('review')"
        >
          Review Pending Submissions
        </button>
      </div>

      <div class="card">
        <h3>Audit History</h3>

        ${auditRecords ||
          '<p>No recorded actions yet.</p>'}
      </div>
    `;
  } catch (error) {
    $('content').innerHTML = `
      <div class="card">
        <h3>Administrator Error</h3>
        <p>${esc(error.message)}</p>
      </div>
    `;
  }
}

// ============================================================
// ADMINISTRATOR: AUTHORISE / REVOKE REVIEWERS
// ============================================================

async function setReviewerPermission(userId, enabled) {
  if (account?.role !== 'admin') {
    alert('Administrator access required.');
    return;
  }

  const action = enabled
    ? 'authorise this investor as a reviewer'
    : 'revoke this investor reviewer access';

  if (!confirm(
    `Do you want to ${action}?`
  )) {
    return;
  }

  try {
    await api(
      `/admin/users/${userId}/reviewer`,
      'POST',
      { enabled }
    );

    alert(
      enabled
        ? 'Investor reviewer authorised.'
        : 'Reviewer access revoked.'
    );

    await renderAdmin();
  } catch (error) {
    err(error);
  }
}

// ============================================================
// START APPLICATION
// ============================================================

boot();
