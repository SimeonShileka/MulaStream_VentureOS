
let csrf = '';
let account = null;
let ventures = [];
let selected = null;
let chatId = null;
let view = 'overview';
let chats = [];
let canReview = false;

const $ = id => document.getElementById(id);

const esc = value =>
  String(value ?? '').replace(/[&<>"']/g, char => ({
    '&': '&amp;',
    '<': '&lt;',
    '>': '&gt;',
    '"': '&quot;',
    "'": '&#39;'
  }[char]));

async function api(path, method = 'GET', body) {
  const options = {
    method,
    credentials: 'same-origin',
    headers: { 'x-csrf-token': csrf }
  };

  if (body !== undefined) {
    options.headers['content-type'] = 'application/json';
    options.body = JSON.stringify(body);
  }

  const response = await fetch('/api' + path, options);
  const data = await response.json().catch(() => ({}));

  if (!response.ok) {
    throw new Error(
      typeof data.detail === 'string'
        ? data.detail
        : 'Request failed'
    );
  }

  return data;
}

function err(error) {
  alert(error.message || String(error));
}

// ============================================================
// AUTHENTICATION
// ============================================================

let signingUp = false;

$('switchAuth').onclick = () => {
  signingUp = !signingUp;

  $('regFields').hidden = !signingUp;

  $('authAction').textContent =
    signingUp ? 'Create account' : 'Sign in';

  $('switchAuth').textContent =
    signingUp ? 'Sign in instead' : 'Create an account';

  $('switchText').textContent =
    signingUp
      ? 'Already have an account?'
      : 'New to MulaStream?';

  $('password').autocomplete =
    signingUp ? 'new-password' : 'current-password';
};

$('authForm').onsubmit = async event => {
  event.preventDefault();

  $('authError').textContent = '';

  const credentials = {
    email: $('email').value,
    password: $('password').value
  };

  try {
    if (signingUp) {
      await api('/register', 'POST', {
        ...credentials,
        name: $('name').value,
        role: $('role').value
      });

      $('switchAuth').click();

      $('authError').style.color = '#008767';
      $('authError').textContent =
        'Account created. Sign in now.';
    } else {
      const result = await api(
        '/login',
        'POST',
        credentials
      );

      csrf = result.csrf;
      await boot();
    }
  } catch (error) {
    $('authError').style.color = '#c34141';
    $('authError').textContent = error.message;
  }
};

async function boot() {
  try {
    account = await api('/me');
    csrf = account.csrf;

    $('auth').hidden = true;
    $('shell').hidden = false;

    $('userLabel').textContent = account.name;
    $('roleLabel').textContent =
      account.role === 'admin'
        ? 'Administrator'
        : account.role === 'investor'
          ? 'Investor'
          : 'Entrepreneur';

    $('avatar').textContent =
      (account.name || 'U')[0].toUpperCase();

    await refreshAll();
    await updateRoleNavigation();

    api('/health')
      .then(data => {
        $('aiPill').textContent =
          `AI: ${data.ai} · ${data.model}`;
      })
      .catch(() => {});
  } catch (error) {
    account = null;
    $('auth').hidden = false;
    $('shell').hidden = true;
  }
}

async function logout() {
  try {
    await api('/logout', 'POST');
  } catch (error) {
    console.warn('Logout request:', error.message);
  }

  csrf = '';
  account = null;
  ventures = [];
  selected = null;
  chats = [];
  chatId = null;
  canReview = false;
  view = 'overview';

  $('auth').hidden = false;
  $('shell').hidden = true;
}

// ============================================================
// WORKSPACE AND NAVIGATION
// ============================================================

async function refreshAll() {
  ventures = await api('/ventures');
  chats = await api('/chats');

  if (!ventures.some(venture => venture.id === selected)) {
    selected = ventures[0]?.id || null;
  }

  $('ventureSelect').innerHTML =
    ventures.map(venture => `
      <option value="${venture.id}">
        ${esc(venture.name)}
      </option>
    `).join('') ||
    '<option value="">No venture yet</option>';

  $('ventureSelect').value = selected || '';

  renderChats();
  await render();
}

$('ventureSelect').onchange = event => {
  selected = Number(event.target.value) || null;
  render();
};

document.querySelectorAll('.nav').forEach(button => {
  button.onclick = () => navigate(button.dataset.view);
});

function navigate(page) {
  if (!account) return;

  const founderPages = [
    'overview',
    'venture',
    'evidence',
    'finance',
    'incubator',
    'readiness'
  ];

  if (
    founderPages.includes(page) &&
    account.role !== 'founder'
  ) {
    return;
  }

  if (
    page === 'admin' &&
    account.role !== 'admin'
  ) {
    return;
  }

  if (page === 'review' && !canReview) {
    alert('Reviewer access is required.');
    return;
  }

  if (
    page === 'investors' &&
    account.role !== 'investor'
  ) {
    return;
  }

  view = page;

  document.querySelectorAll('.nav').forEach(button => {
    button.classList.toggle(
      'active',
      button.dataset.view === page
    );
  });

  render();
}

async function updateRoleNavigation() {
  const isAdmin = account?.role === 'admin';
  const isFounder = account?.role === 'founder';
  const isInvestor = account?.role === 'investor';

  canReview = false;

  try {
    const status = await api('/review/status');
    canReview = Boolean(status.allowed);
  } catch (error) {
    canReview = false;
  }

  // Administrator permissions are established by the backend.
  if (isAdmin) {
    canReview = true;
  }

  const founderPages = [
    'overview',
    'venture',
    'evidence',
    'finance',
    'incubator',
    'readiness'
  ];

  document.querySelectorAll('.nav').forEach(button => {
    const page = button.dataset.view;
    let visible = false;

    if (founderPages.includes(page)) {
      visible = isFounder;
    } else if (page === 'investors') {
      visible = isInvestor;
    } else if (page === 'review') {
      visible = canReview;
    } else if (page === 'admin') {
      visible = isAdmin;
    } else if (page === 'chat') {
      visible = true;
    }

    button.hidden = !visible;
    button.style.display = visible ? '' : 'none';
  });

  $('ventureSelect').hidden = !isFounder;
  $('ventureSelect').style.display =
    isFounder ? '' : 'none';

  const newVentureButton =
    document.querySelector('.top-right button');

  if (newVentureButton) {
    newVentureButton.hidden = !isFounder;
    newVentureButton.style.display =
      isFounder ? '' : 'none';
  }

  if (isAdmin) {
    navigate('admin');
  } else if (isInvestor) {
    navigate('investors');
  } else {
    navigate('overview');
  }
}

function renderChats() {
  $('chatList').innerHTML =
    chats.map(chat => `
      <div class="chat-item">
        <button
          onclick="openChat(${chat.id})"
          title="${esc(chat.title)}"
        >
          ${esc(chat.title)}
        </button>

        <button
          class="chat-tools"
          onclick="renameChat(${chat.id})"
          title="Rename"
        >
          ✎
        </button>

        <button
          class="chat-tools"
          onclick="deleteChat(${chat.id})"
          title="Delete"
        >
          ×
        </button>
      </div>
    `).join('') ||
    '<div class="mini" style="padding:12px">Your saved chats will appear here.</div>';
}

// ============================================================
// CHAT MANAGEMENT
// ============================================================

async function newChat() {
  try {
    const result = await api('/chats', 'POST', {
      venture_id: selected || null
    });

    await refreshAll();
    await openChat(result.id);
  } catch (error) {
    err(error);
  }
}

async function openChat(id) {
  chatId = id;
  navigate('chat');
}

async function renameChat(id) {
  const chat = chats.find(item => item.id === id);

  const title = prompt(
    'Rename this conversation',
    chat?.title || ''
  );

  if (!title) return;

  try {
    await api(`/chats/${id}`, 'PATCH', { title });
    await refreshAll();
  } catch (error) {
    err(error);
  }
}

async function deleteChat(id) {
  if (!confirm(
    'Delete this chat and all its messages permanently?'
  )) {
    return;
  }

  try {
    await api(`/chats/${id}`, 'DELETE');

    if (chatId === id) {
      chatId = null;
    }

    await refreshAll();
  } catch (error) {
    err(error);
  }
}

// ============================================================
// CREATE VENTURE
// ============================================================

function openModal() {
  if (account?.role !== 'founder') return;
  $('modal').hidden = false;
}

function closeModal() {
  $('modal').hidden = true;
}

$('ventureForm').onsubmit = async event => {
  event.preventDefault();

  const form = event.target;
  const data = Object.fromEntries(new FormData(form));

  try {
    const result = await api(
      '/ventures',
      'POST',
      data
    );

    selected = result.id;

    closeModal();
    form.reset();

    await refreshAll();

    navigate('overview');
  } catch (error) {
    err(error);
  }
};

// ============================================================
// MAIN PAGE RENDERING
// ============================================================

function renderStartPage() {
  const pages = {
    overview: {
      heading: 'Mission Control',
      intro:
        'Track founder missions, evidence and financial assumptions.',
      points: [
        'Create a venture workspace',
        'Complete business missions',
        'Review your evidence'
      ]
    },

    venture: {
      heading: 'Venture Genome',
      intro:
        'Create and update your business profile.',
      points: [
        'Business name and industry',
        'Target customers',
        'Value proposition'
      ]
    },

    evidence: {
      heading: 'Evidence Ledger',
      intro:
        'Record business claims and supporting sources.',
      points: [
        'Save evidence claims',
        'Describe supporting sources',
        'Track verification status'
      ]
    },

    finance: {
      heading: 'Financial Laboratory',
      intro:
        'Calculate projected revenue, expenses and profit.',
      points: [
        'Enter financial assumptions',
        'Calculate estimated results',
        'Save updated figures'
      ]
    },

    incubator: {
      heading: '90-Day Incubator',
      intro:
        'Complete eight stages of business incubation.',
      points: [
        'Write each deliverable',
        'Submit evidence',
        'Advance after reviewer approval'
      ]
    }
  };

  const page = pages[view] || pages.overview;

  $('content').innerHTML = `
    <div class="hero">
      <span class="eyebrow">
        ${esc(page.heading.toUpperCase())}
      </span>

      <h1>${esc(page.heading)}</h1>

      <p>${esc(page.intro)}</p>

      <div class="toolbar">
        <button
          class="primary"
          onclick="openModal()"
        >
          + Create your first venture
        </button>

        <button
          class="ghost"
          onclick="newChat()"
        >
          Ask the AI business mentor
        </button>
      </div>
    </div>

    <div class="card">
      <h3>What you can do here</h3>

      ${page.points.map(point => `
        <div class="record">
          ✓ ${esc(point)}
        </div>
      `).join('')}
    </div>
  `;
}

async function render() {
  const titles = {
    overview: 'Venture mission control',
    venture: 'Your Venture Genome',
    evidence: 'Evidence ledger',
    finance: 'Financial laboratory',
    chat: 'MulaStream AI mentor',
    incubator: '90-day investment readiness',
    readiness: 'Readiness & rewards',
    investors: 'Investor opportunities',
    review: 'Mentor review queue',
    admin: 'Administration'
  };

  $('pageTitle').textContent =
    titles[view] || 'MulaStream VentureOS';

  if (view === 'chat') return renderChat();
  if (view === 'readiness') return renderReadiness();
  if (view === 'investors') return renderInvestors();
  if (view === 'review') return renderReviews();
  if (view === 'admin') return renderAdmin();

  if (!selected) {
    renderStartPage();
    return;
  }

  if (view === 'incubator') {
    return renderIncubator();
  }

  const requestedView = view;
  const requestedVenture = selected;

  try {
    const data = await api(
      `/ventures/${requestedVenture}/dashboard`
    );

    if (
      view !== requestedView ||
      selected !== requestedVenture
    ) {
      return;
    }

    if (view === 'overview') overview(data);
    if (view === 'venture') genome(data);
    if (view === 'evidence') evidence(data);
    if (view === 'finance') finance(data);
  } catch (error) {
    if (
      view === requestedView &&
      selected === requestedVenture
    ) {
      $('content').textContent = error.message;
    }
  }
}

// ============================================================
// MISSION CONTROL
// ============================================================

function overview(data) {
  const venture = data.venture;
  const missions = data.missions;
  const records = data.evidence;

  const completed = missions.filter(
    mission => mission.state === 'done'
  ).length;

  $('content').innerHTML = `
    <div class="hero">
      <span class="eyebrow">
        ACTIVE VENTURE / ${esc(venture.location || 'NAMIBIA')}
      </span>

      <h1>${esc(venture.name)}</h1>

      <p>
        ${esc(
          venture.problem ||
          'Define the customer problem you want to solve.'
        )}
      </p>

      <button
        class="primary"
        onclick="navigate('venture')"
      >
        Explore Venture Genome
      </button>
    </div>

    <div class="grid">
      <div class="card">
        <span class="eyebrow">
          VALIDATION MISSIONS
        </span>

        <div class="metric">
          ${completed} / ${missions.length}
        </div>

        <p>Self-reported completed missions</p>
      </div>

      <div class="card">
        <span class="eyebrow">
          EVIDENCE RECORDS
        </span>

        <div class="metric">
          ${records.length}
        </div>

        <p>Evidence awaiting independent verification</p>
      </div>

      <div class="card">
        <span class="eyebrow">
          ESTIMATED MONTHLY RESULT
        </span>

        <div class="metric">
          N$ ${data.financials.estimated_profit.toLocaleString()}
        </div>

        <p>Illustrative financial estimate</p>
      </div>
    </div>

    <div class="grid two">
      <div class="card">
        <h3>Business missions</h3>

        ${missions.map(mission => `
          <label class="mission">
            <input
              type="checkbox"
              ${mission.state === 'done' ? 'checked' : ''}
              onchange="toggleMission(${mission.id})"
            >

            <span>
              <strong>${esc(mission.title)}</strong>

              <small>
                ${mission.state === 'done'
                  ? 'Marked complete'
                  : 'Not completed'}
              </small>
            </span>
          </label>
        `).join('')}
      </div>

      <div class="card">
        <h3>Venture progress</h3>

        <p>
          Build your business using actual customer
          evidence and tested assumptions.
        </p>

        <div class="toolbar">
          <button
            class="ghost"
            onclick="navigate('evidence')"
          >
            View evidence
          </button>

          <button
            class="primary"
            onclick="navigate('incubator')"
          >
            Open incubator
          </button>
        </div>
      </div>
    </div>
  `;
}

async function toggleMission(id) {
  try {
    await api(`/missions/${id}/toggle`, 'POST');
    await render();
  } catch (error) {
    err(error);
  }
}

